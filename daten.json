   "ingredients": [
    "2 Packungen Veganes Hack (ins. 360g)",
    "1 TL Olivenöl",
    "1 Zwiebel",
    "1/2 TL Paprikapulver, edelsüß",
    "1/2 TL Knoblauchpulver",
    "300 g Nudeln",
    "200 g Gewürzgurken",
    "1 Eisbergsalat",
    "250 g Kirschtomaten",
    "400 g Seidentofu",
    "2 EL Senf",
